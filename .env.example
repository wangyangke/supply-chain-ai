# Supply chain research service — environment template.
# No real credentials are required to run this project.
# All data ships as JSON fixtures committed to the repository.

# Research snapshot date (YYYY-MM-DD). The service reports this as `as_of`.
SCR_AS_OF=2026-08-21

# Host/port for the HTTP API when launched via `uvicorn` or the CLI.
SCR_HOST=127.0.0.1
SCR_PORT=8000

# Path to the dataset directory. Defaults to ./data relative to the package.
SCR_DATA_DIR=./data

# User-Agent used by the data-fetch scripts when calling SEC EDGAR.
# EDGAR requires a descriptive UA with contact info; replace with your own.
SCR_EDGAR_USER_AGENT=SupplyChainResearch/1.0 (research@example.com)

# ---------------------------------------------------------------------------
# Online research agent (ALL OPTIONAL — zero-config by default).
# Without any keys the agent uses DuckDuckGo (free) + rule-based verification.
# Set keys below for higher-quality results (Tavily/Brave + LLM verification).
# ---------------------------------------------------------------------------

# Search backend: duckduckgo (default, free) | tavily | brave
# SCR_SEARCH_BACKEND=duckduckgo
# SCR_TAVILY_API_KEY=
# SCR_BRAVE_API_KEY=

# OpenAI-compatible LLM endpoint for identity resolution and evidence
# verification (entity disambiguation / co-occurrence guard / quote extraction).
# Without these the agent falls back to rule-based verification (needs_review).
# SCR_LLM_BASE_URL=http://127.0.0.1:15721/v1
# SCR_LLM_API_KEY=
# SCR_LLM_MODEL=gpt-4o-mini
